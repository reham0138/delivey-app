# Copy to .env and fill in real values. Never commit .env.

PORT=3000
MONGODB_URI=mongodb+srv://user:password@cluster.example.net/crown-anchor
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_TTL=15m
REFRESH_TTL_DAYS=7
FRONTEND_URL=http://localhost:5173
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=123456
# Password assigned to every non-admin fixture user created by `npm run seed`
# and `npm run seed:users` (minimum 8 characters). Never commit a real value.
SEED_USER_PASSWORD=


