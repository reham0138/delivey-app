# Base URL of the NestJS backend (docs/API_CONTRACT.md). No trailing path needed.
# Must include the /api/v1 prefix. Read at build time — rebuild after changing.
VITE_API_URL=http://localhost:3000/api/v1

# Optional semantic meal-search service. Leave empty/unset to disable smart search
# (the UI then uses normal backend search only).
# VITE_SEARCH_API_URL=http://127.0.0.1:8000
